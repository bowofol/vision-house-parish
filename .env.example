# Copy to .env.local for local use. Never commit real settings or credentials.
# Leave closed until an actual Apps Script receipt is verified in Google Sheets.
REGISTRATION_ENABLED=false

# Local dev server only. Never opens the deployed frontend/API. Restore false
# and restart npm.cmd run dev immediately after a controlled manual test.
REGISTRATION_LOCAL_TEST_ENABLED=false

# Exact website origin, with no path or trailing slash. Use HTTPS on Vercel.
REGISTRATION_ALLOWED_ORIGIN=http://127.0.0.1:8000

# Exact deployed Google Apps Script HTTPS web app /exec URL.
APPS_SCRIPT_EXEC_URL=

# Same private secret as APPS_SCRIPT_SHARED_SECRET in Apps Script Properties.
# Reuse the existing privately configured key unchanged. Never put it in browser files.
APPS_SCRIPT_SHARED_SECRET=
