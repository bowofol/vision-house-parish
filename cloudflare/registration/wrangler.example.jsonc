{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vision-house-registration",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "REGISTRATION_ENABLED": "false",
    "REGISTRATION_ALLOWED_ORIGIN": "https://vision-house-parishweb-pi.vercel.app"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vision-house-registration",
    "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "REGISTRATION_RATE_LIMITER",
    "namespace_id": "10001",
    "simple": { "limit": 30, "period": 60 }
  }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
